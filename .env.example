APP_DOMAIN=app.example.com
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Neon Postgres. Copy both strings from the Neon console (Connect > Prisma).
# DATABASE_URL is the pooled connection (host contains "-pooler") used by the app.
# DIRECT_URL is the direct connection (no "-pooler") used by Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_customers,write_customers,read_discounts,write_discounts,write_files,read_themes
# SHOP_CUSTOM_DOMAIN=shop.example.com
# Shopify App Pricing. The Pro plan handle in the Partner Dashboard must be "pro".
# Required in production for paid-plan detection. See docs/deployment.md step 5.
# SHOPIFY_APP_HANDLE=leaf-popups
# SHOPIFY_PARTNER_ORG_ID=
# SHOPIFY_PARTNER_API_ACCESS_TOKEN=
# SHOPIFY_APP_GID=gid://shopify/App/1234
# Testing only. Do not set this to true in production.
# Grants Pro features without a Shopify subscription. Only the value "true" turns this on.
PRO_UNLOCKED=false
