APP_DOMAIN=app.example.com
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL. Use a long, unique, URL-safe password and repeat it in DATABASE_URL.
# Restrict inbound TCP 5432 to your static IP in the DigitalOcean Cloud Firewall.
POSTGRES_DB=leaf_popups
POSTGRES_USER=leaf_popups
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432
DATABASE_URL=postgresql://leaf_popups:replace-with-a-long-random-password@db:5432/leaf_popups?schema=public

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_customers,write_customers,read_discounts,write_discounts,write_files
# SHOP_CUSTOM_DOMAIN=shop.example.com
# Shopify App Pricing. The Pro plan handle in the Partner Dashboard must be "pro".
# Required in production for paid-plan detection. See docs/deployment.md step 5.
# SHOPIFY_APP_HANDLE=leaf-popups
# SHOPIFY_PARTNER_ORG_ID=
# SHOPIFY_PARTNER_API_ACCESS_TOKEN=
# SHOPIFY_APP_GID=gid://shopify/App/1234
# Testing only. Do not set this to true in production.
# Grants Pro features without a Shopify subscription. Only the value "true" turns this on.
PRO_UNLOCKED=false
